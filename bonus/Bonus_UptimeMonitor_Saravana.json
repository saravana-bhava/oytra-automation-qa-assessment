{
  "name": "Bonus – Uptime Monitor (demo.realworld.show)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "0612c833-e985-49d1-8fbb-4f37ec033b2a"
    },
    {
      "parameters": {
        "jsCode": "// GET the app up to 3 times; record status + response time of the final attempt.\nconst url = 'https://demo.realworld.show/';\nlet status = 0, ms = 0, error = null;\nfor (let attempt = 1; attempt <= 3; attempt++) {\n  const t0 = Date.now();\n  try {\n    const res = await this.helpers.httpRequest({ method: 'GET', url, returnFullResponse: true, ignoreHttpStatusErrors: true, timeout: 10000 });\n    status = res.statusCode; error = null;\n  } catch (e) { status = 0; error = e.message; }\n  ms = Date.now() - t0;\n  if (status === 200) break;\n  await new Promise(r => setTimeout(r, 3000));\n}\n// keep history for the daily summary (persists while the workflow is active)\nconst store = $getWorkflowStaticData('global');\nstore.checks = (store.checks || []).concat({ t: Date.now(), status, ms }).slice(-400);\nreturn [{ json: { url, status, ms, error, checkedAt: new Date().toISOString(), slow: ms > 3000 } }];"
      },
      "name": "Ping with retries + timing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "a3fedc6c-eafc-477a-b7e2-31ae256310d9"
    },
