    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst since = Date.now() - 24 * 3600 * 1000;\nconst c = (store.checks || []).filter(x => x.t >= since);\nif (!c.length) return [{ json: { text: '📊 Uptime summary: no checks recorded in the last 24h.' } }];\nconst up = c.filter(x => x.status === 200);\nconst avg = Math.round(c.reduce((s, x) => s + x.ms, 0) / c.length);\nconst max = Math.max(...c.map(x => x.ms));\nreturn [{ json: { text: `📊 <b>Uptime summary (24h)</b> — https://demo.realworld.show/\\nChecks: ${c.length}\\nUptime: ${(up.length / c.length * 100).toFixed(2)}%\\nAvg response: ${avg} ms, worst: ${max} ms\\nFailures: ${c.length - up.length}` } }];"
      },
