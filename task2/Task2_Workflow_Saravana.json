    {
      "parameters": {
        "jsCode": "// Keep only the 5 highest-scoring stories, reshaped to the fields we need.\nconst hits = $input.first().json.hits || [];\nif (!hits.length) throw new Error('HN API returned no stories');\nreturn hits\n  .filter(h => h.title)\n  .sort((a, b) => (b.points || 0) - (a.points || 0))\n  .slice(0, 5)\n  .map((h, i) => ({ json: {\n    rank: i + 1, id: h.objectID, title: h.title,\n    url: h.url || 'https://news.ycombinator.com/item?id=' + h.objectID,\n    points: h.points || 0, comments: h.num_comments || 0, author: h.author,\n  }}));"
      },
      "name": "Top 5 by points",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "9a94309d-7ef9-46c3-b876-effce9d38ba3"
    },
    {
      "parameters": {
        "url": "={{ \"https://hacker-news.firebaseio.com/v0/item/\" + ($json.kids && $json.kids.length ? $json.kids[0] : $json.id) + \".json\" }}",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Top story details (API 2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
