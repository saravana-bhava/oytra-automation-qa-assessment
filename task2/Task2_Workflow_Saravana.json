      },
      "name": "Fetch #1 story item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "executeOnce": true,
      "id": "7b389315-5d9e-468b-972a-f7881c3e8ed7"
    },
    {
      "parameters": {
        "jsCode": "// Combine the top 5 with the enrichment (top comment of the #1 story).\nconst top = $('Top 5 by points').all().map(i => i.json);\nconst c = $input.first().json || {};\nconst decode = s => s.replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16))).replace(/&#(\\d+);/g, (_, d) => String.fromCodePoint(+d)).replace(/&quot;/g, '\"').replace(/&gt;/g, '>').replace(/&lt;/g, '<').replace(/&amp;/g, '&');\nconst strip = s => decode(String(s || '').replace(/<p>/g, ' ').replace(/<[^>]+>/g, ' ')).replace(/\\s+/g, ' ').trim();\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst topComment = strip(c.text).slice(0, 280);\nconst lines = top.map(s => `${s.rank}. <a href=\"${esc(s.url)}\">${esc(s.title)}</a> — ${s.points} pts, ${s.comments} comments`);\nreturn [{ json: {\n  topPoints: top[0].points,\n  topTitle: top[0].title,\n  digest: lines.join('\\n'),\n  topComment: topComment ? esc(topComment) + (c.by ? ' — <i>' + esc(c.by) + '</i>' : '') : '(no comments yet)',\n}}];"
      },
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "id": "a19558c1-08f3-48d7-a317-bea6a2bdeacd"
    },
    {
      "parameters": {
